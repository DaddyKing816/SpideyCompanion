<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SpideyCompanion</AssemblyName>
    <RootNamespace>SpideyCompanion</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyTitle>Spidey Companion - media helper for the Spider-Man live wallpaper</AssemblyTitle>
    <Company>Spider-Man Wallpaper project</Company>
    <Version>1.3.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
    <Reference Include="System.Runtime.WindowsRuntime" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <!-- The buddy's 46 Shimeji poses, embedded so the exe stays standalone.
       They land in the assembly as SpideyCompanion.shimeji.shimeNN.png and
       BuddyRenderer finds them by file-name suffix. -->
  <ItemGroup>
    <EmbeddedResource Include="shimeji\shime*.png" />
  </ItemGroup>
</Project>
