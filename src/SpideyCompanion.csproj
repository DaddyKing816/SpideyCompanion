<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SpideyCompanion</AssemblyName>
    <RootNamespace>SpideyCompanion</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyTitle>Spidey Companion - media helper for the Spider-Man live wallpaper</AssemblyTitle>
    <Company>Spider-Man Wallpaper project</Company>
    <Version>1.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
    <Reference Include="System.Runtime.WindowsRuntime" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <!-- The buddy's 46 Shimeji poses, embedded so the exe stays standalone.
       The poses travel as text (poses-idat-*.json: each PNG's compressed
       pixel stream + header/trailer chunks, base64) because the repo's
       snapshot tooling accepts UTF-8 only; PoseTool.cs reassembles the
       original PNG files byte-for-byte, locally and in CI alike. -->
  <Target Name="BuildPosesWin" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="dotnet build posetool/PoseTool.csproj -c Release -o tools-build &amp;&amp; dotnet tools-build\PoseTool.dll . poses/poses-idat-1a-0.json poses/poses-idat-1a-1.json poses/poses-idat-1a-2.json poses/poses-idat-1b-0.json poses/poses-idat-1b-1.json poses/poses-idat-1b-2.json poses/poses-idat-2a-0.json poses/poses-idat-2a-1.json poses/poses-idat-2a-2.json poses/poses-idat-2b-0.json poses/poses-idat-2b-1.json poses/poses-idat-2b-2.json" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <Target Name="BuildPosesPosix" BeforeTargets="BeforeBuild" Condition="'$(OS)' != 'Windows_NT'">
    <Exec Command="dotnet build posetool/PoseTool.csproj -c Release -o tools-build &amp;&amp; dotnet tools-build/PoseTool.dll . poses/poses-idat-1a-0.json poses/poses-idat-1a-1.json poses/poses-idat-1a-2.json poses/poses-idat-1b-0.json poses/poses-idat-1b-1.json poses/poses-idat-1b-2.json poses/poses-idat-2a-0.json poses/poses-idat-2a-1.json poses/poses-idat-2a-2.json poses/poses-idat-2b-0.json poses/poses-idat-2b-1.json poses/poses-idat-2b-2.json" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="shime*.png" />
    <!-- The pose tool is built separately; never compiled into the app. -->
    <Compile Remove="posetool\**" />
    <EmbeddedResource Remove="posetool\**" />
    <None Remove="posetool\**" />
  </ItemGroup>
</Project>
