<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SpideyCompanion-Setup-v1.3.0</AssemblyName>
    <RootNamespace>SpideySetup</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyTitle>Spidey Companion Setup</AssemblyTitle>
    <Company>Spider-Man Wallpaper project</Company>
    <Version>1.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Payload files are embedded data, never compiled. -->
    <Compile Remove="payload\**" />
    <None Remove="payload\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload\SpideyCompanion-v1.3.0.exe" />
    <EmbeddedResource Include="payload\SpideyCompanion-v1.3.0.exe.config" />
    <EmbeddedResource Include="payload\README.txt" />
    <EmbeddedResource Include="payload\update-feed.txt" />
    <EmbeddedResource Include="payload\Program.cs" />
    <EmbeddedResource Include="payload\Buddy.cs" />
  </ItemGroup>
</Project>
